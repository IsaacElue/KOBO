SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. A direct postgres:// connection string (Settings -> Database in
# the Supabase dashboard) — only needed to run scripts/run-migration.ts.
# The Supabase CLI (`supabase db push`) needs an authenticated login and/or
# local Docker, neither available in every environment; this is the
# fallback for applying supabase/migrations/*.sql directly. Not needed for
# normal `npm run dev` — the app itself only ever uses the two vars above.
SUPABASE_DB_URL=

# Optional. Defaults to backend/keys/backend-wallet.json (auto-generated on first run).
BACKEND_WALLET_KEYPAIR_PATH=

# Optional. Defaults to Solana's public devnet cluster.
SOLANA_RPC_URL=

TRANSAK_API_KEY=
TRANSAK_API_SECRET=
TRANSAK_ENV=staging

# Must match a domain registered against TRANSAK_API_KEY in the Transak
# partner dashboard, or widget session creation is rejected. Defaults to a
# placeholder ("kobo.app") if unset — confirm the real value with Person A.
TRANSAK_REFERRER_DOMAIN=

# Origin allowed to call this API via CORS (the frontend's URL). Optional,
# defaults to http://localhost:3000 (frontend dev server). Set to the real
# deployed frontend URL in staging/production.
FRONTEND_ORIGIN=