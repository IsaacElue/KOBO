# ═══════════════════════════════════════════════════════════════════════════
#  Copy to .env for local dev. For the Railway deploy, set these in the
#  Railway dashboard (Variables tab) instead — do NOT upload a .env file.
#  See DEPLOYMENT.md for the full per-variable walkthrough and which of these
#  are LOCAL-ONLY and must be left unset in a deployed environment.
# ═══════════════════════════════════════════════════════════════════════════

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. A direct postgres:// connection string (Settings -> Database in
# the Supabase dashboard) — only needed to run scripts/run-migration.ts.
# The Supabase CLI (`supabase db push`) needs an authenticated login and/or
# local Docker, neither available in every environment; this is the
# fallback for applying supabase/migrations/*.sql directly. Not needed for
# normal `npm run dev` — the app itself only ever uses the two vars above.
SUPABASE_DB_URL=

# Optional locally (defaults to backend/keys/backend-wallet.json, auto-generated
# on first run). ⚠️ REQUIRED on Railway: the container filesystem is ephemeral,
# so without a persistent path the pooled wallet is regenerated on every deploy
# and any funded USDC is stranded. Point this at a mounted Railway volume, e.g.
# BACKEND_WALLET_KEYPAIR_PATH=/data/backend-wallet.json  (volume mounted at /data).
# See DEPLOYMENT.md → "Backend wallet keypair".
BACKEND_WALLET_KEYPAIR_PATH=

# Optional. Defaults to Solana's public devnet cluster.
SOLANA_RPC_URL=

# ── On-ramp provider ────────────────────────────────────────────────────────
# Active provider for POST /funding. "moonpay" (default) or "transak". Transak
# config below is kept working for a fast swap-back; only one provider's keys
# need to be real at a time.
ONRAMP_PROVIDER=moonpay

# MoonPay partner keys (dashboard.moonpay.com → Developers). Test keys
# (pk_test_/sk_test_/wk_test_) work against the sandbox with no approval;
# pk_live_/sk_live_/wk_live_ appear once the integration is approved.
#   PUBLISHABLE — the widget `apiKey` param (test key auto-selects sandbox)
#   SECRET      — server-side HMAC signing of the widget URL
#   WEBHOOK     — verifying the Moonpay-Signature-V2 header on POST /webhooks/moonpay
MOONPAY_PUBLISHABLE_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_WEBHOOK_KEY=

# Destination asset. Live: "usdc_sol" (default). MoonPay's sandbox does NOT
# support usdc_sol — set "pyusd_sol" (a test-mode Solana stablecoin) for
# sandbox testing, flip back to usdc_sol for production.
MOONPAY_CRYPTO_CURRENCY_CODE=usdc_sol

# Optional. Base fiat, defaults to "eur".
MOONPAY_BASE_CURRENCY_CODE=

# ⚠️ LOCAL-ONLY. This MoonPay account enforces "IP restriction on signed URLs":
# every signed widget URL must carry allowedIpAddress = the end user's public
# IP. Deployed behind Railway's proxy, req.ip (with TRUST_PROXY=1) already IS
# the real client IP — so this MUST be left UNSET on Railway. Set it only for
# local dev (req.ip is loopback there), to your machine's current public IP.
MOONPAY_ALLOWED_IP_OVERRIDE=

# Optional. Where MoonPay redirects the customer after the purchase (it
# appends transactionId + transactionStatus). Defaults to no redirect.
MOONPAY_REDIRECT_URL=

# ── Transak (inactive unless ONRAMP_PROVIDER=transak) ───────────────────────
TRANSAK_API_KEY=
TRANSAK_API_SECRET=
TRANSAK_ENV=staging

# Must match a domain registered against TRANSAK_API_KEY in the Transak
# partner dashboard, or widget session creation is rejected. Defaults to a
# placeholder ("kobo.app") if unset — confirm the real value with Person A.
TRANSAK_REFERRER_DOMAIN=

# Allowed browser origins for CORS. Comma-separated — one deploy can serve the
# real domain(s) and localhost at once. Optional, defaults to
# http://localhost:3000. On Railway set:
#   FRONTEND_ORIGIN=https://kobopayments.com,https://www.kobopayments.com,http://localhost:3000
FRONTEND_ORIGIN=

# Express `trust proxy` value — makes req.ip resolve to the real client IP from
# X-Forwarded-For (needed for MoonPay's allowedIpAddress). Optional, defaults to
# "1" (one proxy hop — correct for Railway). Set explicitly to "1" on Railway;
# leave unset / "false" for local dev.
TRUST_PROXY=

# NOTE: PORT is injected automatically by Railway — do not set it manually.
# The app reads process.env.PORT and falls back to 4000 locally.

# ⚠️ LOCAL-ONLY, NEVER on Railway: DEV_SKIP_AUTH bypasses requireAuth with a
# seeded user. It has no line in this file on purpose — it must never be set in
# a deployed environment. (Companion: NEXT_PUBLIC_DEV_SKIP_AUTH on the frontend.)