# Base URL of the real Kobo backend API. Unset (or empty) => the app runs entirely
# against the mock data/API layer in lib/kobo/*. Set this once POST /transfers is live.
# NEXT_PUBLIC_KOBO_API_URL=https://api.kobo.example.com

# Real `users.id` (uuid) of this app's single demo sender, created via POST /users
# with role: "sender" — there's no auth/login yet (see KOBO_BUILD_PLAN.md ground
# rules), so this stands in for "who is using the app" until real auth lands.
# Only read when NEXT_PUBLIC_KOBO_API_URL is also set; ignored in mock mode.
# NEXT_PUBLIC_KOBO_SENDER_ID=00000000-0000-0000-0000-000000000000
